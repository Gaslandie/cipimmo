{
  "name": "luminor-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/optimize-images.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/optimize-images.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "next lint",
    "build:pages": "node scripts/optimize-images.mjs && PAGES_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/cipimmo next build && node scripts/prepare-pages.mjs",
    "build:bluehost": "node scripts/optimize-images.mjs && PAGES_EXPORT=1 NEXT_PUBLIC_BASE_PATH= next build && EXPORT_BASE_PATH= node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.4",
    "bootstrap": "^5.3.7",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "mapbox-gl": "^3.13.0",
    "next": "15.5.27",
    "odometer": "^0.4.8",
    "photoswipe": "^5.4.4",
    "react": "19.0.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.0.8",
    "react-fast-marquee": "^1.6.5",
    "react-parallax": "^3.5.2",
    "react-photoswipe-gallery": "^3.1.1",
    "react-player": "^3.3.1",
    "react-scroll-parallax": "^3.4.5",
    "sass": "^1.89.2",
    "splitting": "^1.1.0",
    "swiper": "12.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bootstrap": "^5.2.10",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.29",
    "brace-expansion@1.x": "1.1.21",
    "picomatch@2.x": "2.3.2"
  }
}
