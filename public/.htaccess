DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirection vers HTTPS et le domaine sans www
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^cipimmo\.com$ [NC]
    RewriteRule ^ https://cipimmo.com%{REQUEST_URI} [R=301,L]

    # Keep historical links while consolidating each page onto its canonical URL.
    RewriteRule ^contact/?$ /contacts/ [R=301,L]
    RewriteRule ^a-propos/?$ /about-us/ [R=301,L]
    RewriteRule ^logements/?$ /listing-left-sidebar/ [R=301,L]
    RewriteRule ^faqs/?$ /FAQs/ [R=301,L]
    RewriteRule ^listing-(?:half-map-(?:grid|list)|right-sidebar|topmap-(?:grid|list))/?$ /listing-left-sidebar/ [R=301,L]
    RewriteRule ^property-details-[1-4]/1/?$ /logements/appartement-coleah/ [R=301,L]
    RewriteRule ^property-details-[1-4]/2/?$ /logements/appartement-coyah-km54/ [R=301,L]
    RewriteRule ^property-details-[1-4]/3/?$ /logements/appartement-ansoumaniah-1/ [R=301,L]
    RewriteRule ^property-details-[1-4]/4/?$ /logements/appartement-ansoumaniah-2/ [R=301,L]
    RewriteRule ^property-details-[1-4]/5/?$ /logements/appartement-ansoumaniah-3/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Next fingerprints these public files, so their URLs change with their content.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" CIP_VERSIONED_ASSET=1
</IfModule>
<IfModule mod_headers.c>
    # Add defaults to static pages and error responses without replacing the
    # stricter policies returned by the private administration through PHP.
    Header always setifempty X-Content-Type-Options "nosniff"
    Header always setifempty X-Frame-Options "DENY"
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header always setifempty Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # Next's static export needs inline hydration scripts and styles. External
    # resources stay restricted to this site and the existing map/video frames.
    Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    # HTTPS applies to this domain only: other Bluehost subdomains are separate.
    Header always setifempty Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

    # Store public files but validate them before reuse. A 304 response avoids
    # downloading unchanged content while keeping catalogue updates visible.
    # PHP responses, including the private administration, are excluded.
    <FilesMatch "\.(?:html?|txt|json|xml|css|js|mjs|svg|ico|jpe?g|png|gif|webp|avif|woff2?|ttf|eot|mp4|webm)$">
        Header set Cache-Control "no-cache"
        Header set Cache-Control "public, max-age=31536000, immutable" env=CIP_VERSIONED_ASSET
    </FilesMatch>
</IfModule>
